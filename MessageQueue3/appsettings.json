{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "MessageQueue3",
      "Environment": "Production"

    }
  },
  "RabbitMq": {
    "HostName": "rabbitmq3",
    "Port": 5673,
    "UserName": "RabbitMqUser",
    "Password": "Pwd4RabbitMq",
    "QueueBinds": [
      {
        "Exchange": "primrose",
        "Queue": "catalog_warehouses",
        "RoutingKey": "catalog_warehouses"
      },
      {
        "Exchange": "primrose",
        "Queue": "catalog_prices",
        "RoutingKey": "catalog_prices"
      },
      {
        "Exchange": "primrose",
        "Queue": "catalog_products",
        "RoutingKey": "catalog_products"
      },
      {
        "Exchange": "primrose",
        "Queue": "catalog_offers",
        "RoutingKey": "catalog_offers"
      }
    ]
  },
  "AllowedHosts": "*"
}
